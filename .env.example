# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git, so your secrets never get committed.

# PostgreSQL. These two values match docker-compose.yml for local development.
#
# On Supabase (staging / production) they are two different addresses of the same database:
#   DATABASE_URL = "Transaction pooler" (port 6543): used by the running app
#   DIRECT_URL   = "Direct connection" or "Session pooler" (port 5432): used for migrations and scripts
# Find both in Supabase: Project Settings > Database > Connection string.
# Put them only in your host's environment settings (and a private .env file on your own computer).
DATABASE_URL=postgres://tostov:tostov@localhost:5432/tostov
DIRECT_URL=postgres://tostov:tostov@localhost:5432/tostov

# The address of the site. Used for the previews shown when a page is shared. No slash at the end.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk (https://dashboard.clerk.com → your app → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The sign-in and sign-up page addresses are set in code (they include the language: /en/sign-in).

# Cloudflare R2 (used later, for photo uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
